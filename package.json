{
  "name": "dsh-ui-auth",
  "version": "0.6.4",
  "description": "DSH Web UI 认证网关：登录保护全部 HTTP/WS 接口；用户管理、邀请码注册、TOTP 两步验证与通行密钥（Passkey/WebAuthn）登录。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "build",
    "docs",
    "assets",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build/client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "npm run build && node --check lib/index.js && node --check lib/webauthn.js && node --check lib/client.js && node --check lib/passkey-browser.js && node --check lib/modern-gateway.js && node --check lib/modern-policy.js && node test/crypto-vectors.cjs && node test/totp-vectors.mjs && node test/client-smoke.cjs && node test/host-smoke.mjs && node test/login-page-check.mjs && node test/security-suite.mjs && node test/modern-policy.test.mjs",
    "prepack": "npm test",
    "verify:clean": "npm run build && git diff --exit-code -- lib",
    "store:check": "node test/store-contract-check.mjs",
    "test:compat:0.1.5": "node test/live-015-check.mjs",
    "test:compat:0.1.1": "node test/live-legacy-check.mjs",
    "test:ui": "node test/live-ui-check.mjs",
    "test:passkey": "node test/live-passkey-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.2 <0.2.0",
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.5-rc.1": "compatible"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.2",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "auth",
    "authentication",
    "login",
    "passkey",
    "webauthn",
    "two-factor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0QwQ0/dsh-ui-auth.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@types/node": "^26.5.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "puppeteer": "^25.9.0",
    "typescript": "^7.0.2"
  }
}
