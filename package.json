{
  "name": "dsh-ui-auth",
  "version": "0.6.0",
  "description": "DSH Web UI 认证网关：登录保护全部 HTTP/WS 接口；用户管理、邀请码注册与 TOTP 两步验证。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/client.js && node --check lib/modern-gateway.js && node --check lib/modern-policy.js && node test/crypto-vectors.cjs && node test/totp-vectors.mjs && node test/client-smoke.cjs && node test/host-smoke.mjs && node test/security-suite.mjs && node test/modern-policy.test.mjs",
    "prepack": "npm test",
    "store:check": "node test/store-contract-check.mjs",
    "test:compat:0.1.5": "node test/live-015-check.mjs",
    "test:compat:0.1.1": "node test/live-legacy-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.2 <0.2.0",
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.5-rc.1": "compatible"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "auth",
    "authentication",
    "login"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0QwQ0/dsh-ui-auth.git"
  },
  "license": "MIT",
  "devDependencies": {
    "puppeteer": "^25.9.0"
  }
}
